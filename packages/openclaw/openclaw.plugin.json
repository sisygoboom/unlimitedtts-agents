{
  "id": "unlimitedtts",
  "name": "UnlimitedTTS",
  "description": "Wallet-paid text-to-speech for OpenClaw agents.",
  "version": "0.1.0",
  "skills": [
    "skills/unlimitedtts"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "environment": {
        "type": "string",
        "enum": [
          "production",
          "staging"
        ],
        "default": "production",
        "description": "Production uses api.unlimitedtts.com on Base mainnet. Staging explicitly uses staging-api.unlimitedtts.com on Base Sepolia."
      },
      "paymentMode": {
        "type": "string",
        "const": "external",
        "default": "external",
        "description": "A separate wallet tool creates PAYMENT-SIGNATURE; wallet keys never enter this plugin."
      },
      "maxUsdcPerCall": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]{1,6})?$",
        "default": "0.10"
      },
      "rolling24hUsdc": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]{1,6})?$",
        "default": "1.00"
      },
      "approvalThresholdUsdc": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]{1,6})?$",
        "default": "0.05"
      },
      "requireApproval": {
        "type": "string",
        "enum": [
          "every-payment",
          "first-payment-and-over-threshold",
          "never"
        ],
        "default": "first-payment-and-over-threshold"
      },
      "outputDirectory": {
        "type": "string",
        "minLength": 1
      },
      "allowedPayees": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        }
      }
    }
  },
  "uiHints": {
    "environment": {
      "label": "Environment",
      "advanced": true
    },
    "paymentMode": {
      "label": "Payment mode"
    },
    "maxUsdcPerCall": {
      "label": "Maximum USDC per call"
    },
    "rolling24hUsdc": {
      "label": "Rolling 24-hour USDC limit"
    },
    "approvalThresholdUsdc": {
      "label": "Approval threshold (USDC)"
    },
    "requireApproval": {
      "label": "Payment approval policy"
    },
    "outputDirectory": {
      "label": "Audio output directory"
    },
    "allowedPayees": {
      "label": "Trusted x402 payees",
      "advanced": true
    }
  },
  "mcpServers": {
    "unlimitedtts": {
      "transport": "stdio",
      "command": "node",
      "args": [
        "./dist/mcp.js"
      ],
      "connectionTimeoutMs": 30000,
      "requestTimeoutMs": 180000
    }
  }
}
